# 산술

"3 + 4 = {3에 4를 더한 값}\n"을 출력한다.  # → 3 + 4 = 7
"10 - 4 = {10에서 4를 뺀 값}\n"을 출력한다.  # → 10 - 4 = 6
"3 * 4 = {3에 4를 곱한 값}\n"을 출력한다.  # → 3 * 4 = 12
"10 / 4 = {10을 4로 나눈 값}\n"을 출력한다.  # → 10 / 4 = 2.5
"10 % 4 = {10을 4로 나눈 나머지}\n"을 출력한다.  # → 10 % 4 = 2
"3^2 = {3에 3을 곱한 값}\n"을 출력한다.  # → 3^2 = 9

# 호출은 겹쳐 사용하세요!
"(2+3)*4 = {2에 3을 더한 값에 4를 곱한 값}\n"을 출력한다.  # → (2+3)*4 = 20

"-5의 절댓값 = {0에서 -5를 뺀 값}\n"을 출력한다.  # → -5의 절댓값 = 5
